<ui:FluentWindow x:Class="NumaLink.App.TrayHubWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Numa Link"
                 Icon="Assets/numa-link.ico"
                 Width="490"
                 SizeToContent="Height"
                 MinWidth="460"
                 MinHeight="250"
                 MaxHeight="740"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource LinkBgBrush}"
                 Foreground="{DynamicResource LinkTextPrimaryBrush}"
                 FontFamily="{StaticResource LinkUiFont}">

    <Grid Background="{DynamicResource LinkBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Draggable Titlebar + Light/Dark + Settings + Window Controls -->
        <Grid Grid.Row="0"
              Background="Transparent"
              Margin="0,0,104,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Border Width="12" Height="12" CornerRadius="999"
                        Background="{DynamicResource LinkPrimaryBrush}" Margin="0,0,10,0"
                        VerticalAlignment="Center" />
                <TextBlock Text="Numa Link"
                           FontFamily="{StaticResource LinkBrandFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource LinkTextPrimaryBrush}"
                           VerticalAlignment="Bottom" />
                <TextBlock x:Name="TitleVersionText"
                           Text="v1.0.5"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LinkTextSecondaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="7,0,0,2.5" />
            </StackPanel>

            <!-- Theme & Settings Icon Buttons (right next to each other, zero overlap) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="ThemeToggleButton"
                        Width="36" Height="34"
                        Margin="0,0,6,0"
                        Padding="0"
                        Cursor="Hand"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        Foreground="{DynamicResource LinkTextPrimaryBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1"
                        Click="ThemeToggle_Click">
                    <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny20" FontSize="17" />
                </Button>
                <Button x:Name="SettingsButton"
                        Width="36" Height="34"
                        Padding="0"
                        Cursor="Hand"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        Foreground="{DynamicResource LinkTextPrimaryBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1"
                        Click="Settings_Click">
                    <ui:SymbolIcon Symbol="Settings20" FontSize="17" />
                </Button>
            </StackPanel>
        </Grid>

        <ui:TitleBar Grid.Row="0"
                     Height="52"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Width="98" />

        <!-- Row 1: Global Alert Banners (Update / Conflict / WinFsp / Status) -->
        <StackPanel Grid.Row="1" Margin="22,2,22,0">
            <!-- Automatic Update Available Banner -->
            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource LinkElevatedBrush}"
                    BorderBrush="{DynamicResource LinkSuccessBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,11"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="UpdateBannerTitle" Text="Actualización disponible"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource LinkSuccessBrush}" />
                        <TextBlock x:Name="UpdateBannerText"
                                   FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                    </StackPanel>
                    <Button x:Name="DownloadUpdateButton" Grid.Column="1" Content="Descargar"
                            Padding="14,7" Margin="0,0,6,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LinkPrimaryBrush}"
                            Foreground="{DynamicResource LinkPrimaryContentBrush}"
                            BorderThickness="0"
                            Click="DownloadUpdate_Click" />
                    <Button Grid.Column="2" Content="×" FontSize="18" Padding="6,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource LinkTextSecondaryBrush}"
                            Click="DismissUpdate_Click" />
                </Grid>
            </Border>

            <!-- NumaFiles Conflict Banner -->
            <Border x:Name="ConflictBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource LinkElevatedBrush}"
                    BorderBrush="{DynamicResource LinkWarmBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,11"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="ConflictTitleText" Text="Numa Files está abierto"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource LinkWarmBrush}" />
                        <TextBlock x:Name="ConflictBodyText" Text="Ciérralo para evitar conflictos de conexión."
                                   FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="CloseConflictButton" Grid.Column="1" Content="Cerrar"
                            Padding="14,7" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LinkWarmBrush}" Foreground="#0E1324" BorderThickness="0"
                            Click="CloseNumaFiles_Click" />
                </Grid>
            </Border>

            <!-- WinFsp Banner -->
            <Border x:Name="WinFspBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource LinkElevatedBrush}"
                    BorderBrush="{DynamicResource LinkWarmBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,11"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="WinFspTitleText" Text="Falta WinFsp"
                               FontSize="15.5" FontWeight="Bold"
                               Foreground="{DynamicResource LinkWarmBrush}" />
                    <TextBlock x:Name="WinFspBannerText" Text="Necesario para montar equipos como unidad (Z:\)."
                               FontSize="14" TextWrapping="Wrap" Margin="0,2,0,10"
                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                    <Button x:Name="InstallWinFspButton" Content="Instalar WinFsp (2.2 MB)"
                            HorizontalAlignment="Stretch" Height="38"
                            FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"
                            Background="{DynamicResource LinkPrimaryBrush}"
                            Foreground="{DynamicResource LinkPrimaryContentBrush}"
                            BorderThickness="0"
                            Click="InstallWinFsp_Click" />
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border x:Name="StatusBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource LinkElevatedBrush}"
                    BorderBrush="{DynamicResource LinkPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBannerText" Grid.Column="0"
                               FontSize="14.5" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                    <Button Grid.Column="1" Content="×" FontSize="18" Padding="8,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource LinkTextSecondaryBrush}"
                            Click="DismissStatus_Click" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Row 2: Three Switchable Visual Structures -->
        <Grid Grid.Row="2" Margin="22,6,22,20">

            <!-- ========================================================= -->
            <!-- LAYOUT 1: QUICK SHARE COMPACT TABS                        -->
            <!-- ========================================================= -->
            <Grid x:Name="LayoutQuickShareRoot" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Segmented Tabs -->
                <Border Grid.Row="0"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="5"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="QsTabNearbyButton" Grid.Column="0"
                                Content="Cercanos (0)"
                                HorizontalAlignment="Stretch" Height="38"
                                FontSize="15" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"
                                Click="QsTabNearby_Click" />
                        <Button x:Name="QsTabMountedButton" Grid.Column="2"
                                Content="Montadas (0)"
                                HorizontalAlignment="Stretch" Height="38"
                                FontSize="15" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"
                                Click="QsTabMounted_Click" />
                    </Grid>
                </Border>

                <!-- Tab Body -->
                <Grid Grid.Row="1">
                    <!-- Nearby Tab -->
                    <Grid x:Name="QsNearbyPanel" Visibility="Visible">
                        <StackPanel x:Name="QsNoPeersState" Margin="0,24,0,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="999"
                                    Background="{DynamicResource LinkSurfaceBrush}"
                                    BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Wifi120" FontSize="28"
                                               Foreground="{DynamicResource LinkPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="QsSearchingText"
                                       Text="Buscando equipos en tu red..."
                                       FontSize="15.5" FontWeight="Medium" TextAlignment="Center"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <ItemsControl x:Name="QsPeersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource LinkSurfaceBrush}"
                                                BorderBrush="{DynamicResource LinkBorderBrush}"
                                                BorderThickness="1.5" CornerRadius="14"
                                                Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding HostAddress}" FontSize="14" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ConnectLabel}" Tag="{Binding Peer}"
                                                        Padding="16,9" FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource LinkPrimaryBrush}"
                                                        Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                        BorderThickness="0" Click="ConnectPeer_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Mounted Tab -->
                    <Grid x:Name="QsMountedPanel" Visibility="Collapsed">
                        <StackPanel x:Name="QsNoDrivesState" Margin="0,24,0,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="999"
                                    Background="{DynamicResource LinkSurfaceBrush}"
                                    BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="HardDrive20" FontSize="28"
                                               Foreground="{DynamicResource LinkSuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="QsNoDrivesText"
                                       Text="Sin unidades conectadas"
                                       FontSize="15.5" FontWeight="Medium" TextAlignment="Center"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <ItemsControl x:Name="QsDrivesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource LinkSurfaceBrush}"
                                                BorderBrush="{DynamicResource LinkSuccessBrush}"
                                                BorderThickness="1.5" CornerRadius="14"
                                                Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="17" FontWeight="Bold"
                                                               Foreground="{DynamicResource LinkTextPrimaryBrush}">
                                                        <Run Text="{Binding DriveLetter, Mode=OneWay}" Foreground="{DynamicResource LinkSuccessBrush}" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding AccessSummary}" FontSize="14" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding OpenLabel}" Tag="{Binding MountPoint}"
                                                            Padding="12,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                                            Background="{DynamicResource LinkPrimaryBrush}"
                                                            Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                            BorderThickness="0" Click="OpenDrive_Click" />
                                                    <Button Content="{Binding UnmountLabel}" Tag="{Binding SessionId}"
                                                            Padding="12,8" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                                            Background="{DynamicResource LinkElevatedBrush}"
                                                            Foreground="{DynamicResource LinkWarmBrush}"
                                                            BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                                            Click="UnmountDrive_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Bottom Dock -->
                <Border Grid.Row="2"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="16,11"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QsDeviceNameText" Grid.Column="0"
                                   FontSize="16.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                        <Button x:Name="QsVisibilityButton" Grid.Column="1"
                                Content="Visible: Todos" Padding="14,7"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"
                                Background="{DynamicResource LinkElevatedBrush}"
                                Foreground="{DynamicResource LinkSuccessBrush}"
                                BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                Click="VisibilityButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- LAYOUT 2: HORIZONTAL TWO-COLUMN DASHBOARD                 -->
            <!-- ========================================================= -->
            <Grid x:Name="LayoutTwoColRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Device Strip -->
                <Border Grid.Row="0"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1.5" CornerRadius="14"
                        Padding="16,11" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TcThisDeviceLabel" Text="ESTE EQUIPO"
                                       FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock x:Name="TcDeviceNameText" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                        </StackPanel>
                        <Button x:Name="TcVisibilityButton" Grid.Column="1"
                                Content="Visible: Todos" Padding="14,7"
                                FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"
                                Background="{DynamicResource LinkElevatedBrush}"
                                Foreground="{DynamicResource LinkSuccessBrush}"
                                BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                Click="VisibilityButton_Click" />
                    </Grid>
                </Border>

                <!-- 2 Side-by-Side Columns -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Nearby Peers -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1.5" CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TcNearbyHeader" Grid.Row="0" Text="EQUIPOS CERCANOS"
                                       FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                            <TextBlock x:Name="TcNoPeersText" Grid.Row="1"
                                       Text="Buscando equipos en tu red..."
                                       FontSize="15.5" TextWrapping="Wrap" Margin="0,20,0,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                                <ItemsControl x:Name="TcPeersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource LinkBgBrush}"
                                                    BorderBrush="{DynamicResource LinkBorderBrush}"
                                                    BorderThickness="1" CornerRadius="12"
                                                    Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding HostAddress}" FontSize="13.5" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ConnectLabel}" Tag="{Binding Peer}"
                                                            Padding="14,7" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource LinkPrimaryBrush}"
                                                            Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                            BorderThickness="0" Click="ConnectPeer_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right: Mounted Drives -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1.5" CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TcMountedHeader" Grid.Row="0" Text="UNIDADES MONTADAS"
                                       FontSize="13.5" FontWeight="Bold" Margin="0,0,0,12"
                                       Foreground="{DynamicResource LinkSuccessBrush}" />
                            <TextBlock x:Name="TcNoDrivesText" Grid.Row="1"
                                       Text="Sin unidades conectadas"
                                       FontSize="15.5" Margin="0,20,0,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                                <ItemsControl x:Name="TcDrivesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource LinkBgBrush}"
                                                    BorderBrush="{DynamicResource LinkSuccessBrush}"
                                                    BorderThickness="1.5" CornerRadius="12"
                                                    Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="16.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource LinkTextPrimaryBrush}">
                                                            <Run Text="{Binding DriveLetter, Mode=OneWay}" Foreground="{DynamicResource LinkSuccessBrush}" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding AccessSummary}" FontSize="13.5" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding OpenLabel}" Tag="{Binding MountPoint}"
                                                                Padding="12,7" Margin="0,0,6,0" FontSize="13.5" FontWeight="SemiBold" Cursor="Hand"
                                                                Background="{DynamicResource LinkPrimaryBrush}"
                                                                Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                                BorderThickness="0" Click="OpenDrive_Click" />
                                                        <Button Content="{Binding UnmountLabel}" Tag="{Binding SessionId}"
                                                                Padding="12,7" FontSize="13.5" FontWeight="SemiBold" Cursor="Hand"
                                                                Background="{DynamicResource LinkElevatedBrush}"
                                                                Foreground="{DynamicResource LinkWarmBrush}"
                                                                BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                                                Click="UnmountDrive_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- LAYOUT 3: BENTO GRID (MODULAR NUMA CARDS)                 -->
            <!-- ========================================================= -->
            <Grid x:Name="LayoutBentoRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bento Pair -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1.5" CornerRadius="16" Padding="16,14">
                        <StackPanel>
                            <TextBlock x:Name="BentoDeviceLabel" Text="ESTE EQUIPO"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                            <TextBlock x:Name="BentoDeviceNameText"
                                       FontFamily="{StaticResource LinkBrandFont}"
                                       FontSize="19" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1.5" CornerRadius="16" Padding="16,14">
                        <StackPanel>
                            <TextBlock x:Name="BentoVisLabel" Text="VISIBILIDAD"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                            <Button x:Name="BentoVisibilityButton"
                                    Content="Visible: Todos"
                                    HorizontalAlignment="Left"
                                    Padding="12,5" Margin="0,6,0,0"
                                    FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"
                                    Background="{DynamicResource LinkElevatedBrush}"
                                    Foreground="{DynamicResource LinkSuccessBrush}"
                                    BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                    Click="VisibilityButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mounted Drives Chips Strip -->
                <Border x:Name="BentoMountedStrip" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        BorderBrush="{DynamicResource LinkSuccessBrush}"
                        BorderThickness="1.5" CornerRadius="14" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="BentoMountedHeader" Text="UNIDADES MONTADAS"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource LinkSuccessBrush}" />
                        <ItemsControl x:Name="BentoDrivesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource LinkElevatedBrush}"
                                            BorderBrush="{DynamicResource LinkBorderBrush}"
                                            BorderThickness="1" CornerRadius="999"
                                            Padding="12,6" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource LinkTextPrimaryBrush}">
                                                <Run Text="{Binding DriveLetter, Mode=OneWay}" Foreground="{DynamicResource LinkSuccessBrush}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="↗" Tag="{Binding MountPoint}" ToolTip="Abrir"
                                                    Padding="6,1" Margin="0,0,4,0" FontSize="14" FontWeight="Bold" Cursor="Hand"
                                                    Background="{DynamicResource LinkPrimaryBrush}"
                                                    Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                    BorderThickness="0" Click="OpenDrive_Click" />
                                            <Button Content="×" Tag="{Binding SessionId}" ToolTip="Desmontar"
                                                    Padding="6,1" FontSize="14" FontWeight="Bold" Cursor="Hand"
                                                    Background="Transparent" Foreground="{DynamicResource LinkWarmBrush}"
                                                    BorderThickness="0" Click="UnmountDrive_Click" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Nearby Peers 2-Column Bento Cards -->
                <Border Grid.Row="2"
                        Background="{DynamicResource LinkSurfaceBrush}"
                        BorderBrush="{DynamicResource LinkBorderBrush}"
                        BorderThickness="1.5" CornerRadius="16" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BentoNearbyHeader" Grid.Row="0" Text="EQUIPOS CERCANOS"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                        <TextBlock x:Name="BentoNoPeersText" Grid.Row="1"
                                   Text="Buscando equipos en tu red..."
                                   FontSize="16" Margin="0,24,0,24" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <ItemsControl x:Name="BentoPeersList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource LinkBgBrush}"
                                                BorderBrush="{DynamicResource LinkBorderBrush}"
                                                BorderThickness="1.5" CornerRadius="14"
                                                Padding="14" Margin="5">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding DeviceIcon}" FontSize="28"
                                                               Foreground="{DynamicResource LinkPrimaryBrush}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,8" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding HostAddress}" FontSize="13"
                                                           TextAlignment="Center" Margin="0,2,0,12"
                                                           Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                <Button Content="{Binding ConnectLabel}" Tag="{Binding Peer}"
                                                        HorizontalAlignment="Stretch" Height="36"
                                                        FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                                        Background="{DynamicResource LinkPrimaryBrush}"
                                                        Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                                        BorderThickness="0" Click="ConnectPeer_Click" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
