<ui:FluentWindow x:Class="NumaLink.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Configuración — Numa Link"
                 Icon="Assets/numa-link.ico"
                 Width="470"
                 SizeToContent="Height"
                 MinWidth="440"
                 MaxHeight="640"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource LinkBgBrush}"
                 Foreground="{DynamicResource LinkTextPrimaryBrush}"
                 FontFamily="{StaticResource LinkUiFont}">

    <Border Background="{DynamicResource LinkBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Titlebar -->
            <Grid Grid.Row="0" Background="Transparent" Margin="0,0,52,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="WindowTitleText"
                           Text="Configuración"
                           FontFamily="{StaticResource LinkBrandFont}"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource LinkTextPrimaryBrush}" />
            </Grid>
            <ui:TitleBar Grid.Row="0" Height="46" ShowMaximize="False" ShowMinimize="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Width="48" />

            <!-- Minimalist 3-Tab Segmented Bar -->
            <Border Grid.Row="1"
                    Margin="20,2,20,14"
                    Background="{DynamicResource LinkSurfaceBrush}"
                    BorderBrush="{DynamicResource LinkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabGeneralBtn" Grid.Column="0" Content="General"
                            HorizontalAlignment="Stretch" Height="34"
                            FontSize="13.5" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"
                            Click="TabGeneral_Click" />
                    <Button x:Name="TabConnectionsBtn" Grid.Column="2" Content="Conexiones"
                            HorizontalAlignment="Stretch" Height="34"
                            FontSize="13.5" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"
                            Click="TabConnections_Click" />
                    <Button x:Name="TabSystemBtn" Grid.Column="4" Content="Sistema"
                            HorizontalAlignment="Stretch" Height="34"
                            FontSize="13.5" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"
                            Click="TabSystem_Click" />
                </Grid>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="2" Margin="20,0,20,20">

                <!-- TAB 1: GENERAL -->
                <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                    <!-- Alias -->
                    <TextBlock x:Name="AliasSectionLabel" Text="NOMBRE DEL EQUIPO"
                               FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource LinkTextSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AliasTextBox" Grid.Column="0"
                                 FontSize="14" Padding="11,7"
                                 Background="{DynamicResource LinkSurfaceBrush}"
                                 Foreground="{DynamicResource LinkTextPrimaryBrush}"
                                 BorderBrush="{DynamicResource LinkBorderBrush}"
                                 BorderThickness="1" />
                        <Button x:Name="SaveAliasButton" Grid.Column="2" Content="Guardar"
                                Padding="14,7" FontSize="13.5" FontWeight="SemiBold" Cursor="Hand"
                                Background="{DynamicResource LinkPrimaryBrush}"
                                Foreground="{DynamicResource LinkPrimaryContentBrush}"
                                BorderThickness="0" Click="SaveAlias_Click" />
                    </Grid>

                    <!-- Layout -->
                    <TextBlock x:Name="LayoutSectionLabel" Text="ESTRUCTURA VISUAL"
                               FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource LinkTextSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <ComboBox x:Name="LayoutCombo" FontSize="14" Margin="0,0,0,16"
                              SelectionChanged="LayoutCombo_SelectionChanged">
                        <ComboBoxItem x:Name="LayoutItemQuickShare" Tag="QuickShareTabs" Content="Quick Share — Pestañas compactas" />
                        <ComboBoxItem x:Name="LayoutItemTwoCol" Tag="TwoColumnHorizontal" Content="Horizontal — 2 columnas" />
                        <ComboBoxItem x:Name="LayoutItemBento" Tag="BentoGrid" Content="Bento Grid — Tarjetas modulares" />
                    </ComboBox>

                    <!-- Language -->
                    <TextBlock x:Name="LanguageSectionLabel" Text="IDIOMA"
                               FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource LinkTextSecondaryBrush}"
                               Margin="2,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="LangEsButton" Content="Español"
                                HorizontalAlignment="Stretch" Height="36"
                                FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                Click="LangEs_Click" />
                        <Button Grid.Column="2" x:Name="LangEnButton" Content="English"
                                HorizontalAlignment="Stretch" Height="36"
                                FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                Click="LangEn_Click" />
                    </Grid>
                </StackPanel>

                <!-- TAB 2: CONNECTIONS -->
                <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" MaxHeight="380">
                    <StackPanel>
                        <TextBlock x:Name="SessionsSectionLabel" Text="SESIONES ACTIVAS"
                                   FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource LinkTextSecondaryBrush}"
                                   Margin="2,0,0,8" />

                        <Border Background="{DynamicResource LinkSurfaceBrush}"
                                BorderBrush="{DynamicResource LinkBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="NoSessionsText" Text="Sin sesiones LAN activas"
                                           FontSize="13.5" Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                <ItemsControl x:Name="SessionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding Id}"
                                                        Padding="11,5" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"
                                                        Background="{DynamicResource LinkElevatedBrush}"
                                                        Foreground="{DynamicResource LinkWarmBrush}"
                                                        BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                                        Click="DisconnectSession_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TrustedSectionLabel" Text="EQUIPOS DE CONFIANZA"
                                   FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource LinkTextSecondaryBrush}"
                                   Margin="2,0,0,8" />

                        <Border Background="{DynamicResource LinkSurfaceBrush}"
                                BorderBrush="{DynamicResource LinkBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,11">
                            <StackPanel>
                                <TextBlock x:Name="NoTrustedText" Text="Sin equipos de confianza guardados"
                                           FontSize="13.5" Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                <ItemsControl x:Name="TrustedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding Id}"
                                                        Padding="11,5" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"
                                                        Background="{DynamicResource LinkElevatedBrush}"
                                                        Foreground="{DynamicResource LinkTextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                                        Click="RevokeTrusted_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: SYSTEM & ABOUT -->
                <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheck"
                                      Content="Abrir minimizado al iniciar Windows"
                                      FontSize="14" Margin="0,0,0,10"
                                      Foreground="{DynamicResource LinkTextPrimaryBrush}"
                                      Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />

                            <CheckBox x:Name="AutoCheckUpdatesCheck"
                                      Content="Buscar actualizaciones automáticamente"
                                      FontSize="14"
                                      Foreground="{DynamicResource LinkTextPrimaryBrush}"
                                      Checked="AutoCheckUpdates_Changed" Unchecked="AutoCheckUpdates_Changed" />

                            <Separator Margin="0,12,0,12" Background="{DynamicResource LinkBorderBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CacheSizeText" Grid.Column="0"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                <Button x:Name="ClearCacheButton" Grid.Column="1"
                                        Content="Limpiar caché" Padding="12,6"
                                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                        Background="{DynamicResource LinkElevatedBrush}"
                                        Foreground="{DynamicResource LinkTextPrimaryBrush}"
                                        BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                        Click="ClearCache_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Compact Updates & About Card -->
                    <Border Background="{DynamicResource LinkSurfaceBrush}"
                            BorderBrush="{DynamicResource LinkBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Numa Link"
                                                   FontFamily="{StaticResource LinkBrandFont}"
                                                   FontSize="15.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource LinkTextPrimaryBrush}" />
                                        <TextBlock x:Name="AboutVersionBadge"
                                                   FontSize="12.5" Margin="6,0,0,1" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource LinkSuccessBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AboutTechText"
                                               FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton" Grid.Column="1"
                                        Content="Buscar actualizaciones"
                                        Padding="12,6" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LinkElevatedBrush}"
                                        Foreground="{DynamicResource LinkPrimaryBrush}"
                                        BorderBrush="{DynamicResource LinkBorderBrush}" BorderThickness="1"
                                        Click="CheckUpdates_Click" />
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText" Visibility="Collapsed"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource LinkTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
